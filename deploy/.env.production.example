# Production-shaped API/worker environment template (placeholders only).
# Copy to a git-ignored file (e.g. deploy/.env.production) and replace values.
# This file documents safe defaults — it is not evidence of a certified deployment.

ENVIRONMENT=production
LOG_LEVEL=INFO
PUBLIC_URL=https://hub.example

# PostgreSQL and queue — use managed services in real deployments
DATABASE_URL=postgresql+psycopg2://vulnops:REPLACE_ME@postgres.example:5432/vulnops
REDIS_URL=redis://valkey.example:6379/0

# Object storage (S3-compatible) — optional until certified backup topology
OBJECT_STORAGE_ENDPOINT=https://s3.example
OBJECT_STORAGE_BUCKET=vulnops-snapshots
OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
OBJECT_STORAGE_SECRET_KEY=REPLACE_ME
OBJECT_STORAGE_REGION=us-east-1

# OIDC — HTTPS issuer and registered API audience (required)
OIDC_ISSUER_URL=https://idp.example/realms/vulnops
OIDC_AUDIENCE=vulnops-api
OIDC_ALLOWED_ALGORITHMS=["RS256"]
OIDC_ORGANIZATION_CLAIM=organizations
OIDC_ROLE_CLAIM=roles
OIDC_SERVICE_SCOPE_CLAIM=scope
OIDC_PRINCIPAL_TYPE_CLAIM=principal_type

# Fail-closed: never enable in production
OIDC_ALLOW_INSECURE_LOOPBACK=false
AUTH_TEST_BYPASS_ENABLED=false

# External adapters — configure only what you operate
# DEFECTDOJO_BASE_URL=https://defectdojo.example
# DEFECTDOJO_API_TOKEN=REPLACE_ME
# WAZUH_BASE_URL=https://wazuh.example:55000
# WAZUH_API_USER=wazuh
# WAZUH_API_PASSWORD=REPLACE_ME
# VULNERABILITY_LOOKUP_BASE_URL=https://vulnerability-lookup.example
