# Staging sandbox credentials template.
# Copy to deploy/.env.staging (git-ignored) and adjust before first use.
# These values are for local sandboxes only — never reuse elsewhere.

# DefectDojo (profile: defectdojo)
DOJO_HTTP_PORT=8081
DOJO_ADMIN_USER=admin
DOJO_ADMIN_PASSWORD=sandbox-admin-password
DOJO_PG_PASSWORD=defectdojo
DOJO_SECRET_KEY=staging-secret-key-change-me
DOJO_CREDENTIAL_KEY=staging-credential-key-change-me

# Wazuh manager API (profile: wazuh)
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh

# Keycloak (profile: keycloak)
KEYCLOAK_HTTP_PORT=8082
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=sandbox-admin-password

# VulnOps api/worker reach sandboxes from inside Docker:
#   DEFECTDOJO_BASE_URL=http://host.docker.internal:8081
#   WAZUH_BASE_URL=https://host.docker.internal:55000
#   OIDC_ISSUER_URL=http://host.docker.internal:8082/realms/vulnops
#   OIDC_AUDIENCE=vulnops-api
