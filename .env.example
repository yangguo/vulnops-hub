# VulnOps Hub local evaluation defaults
# Copy to .env and adjust before `docker compose up` or `uv run uvicorn vulnops.main:app`

ENVIRONMENT=development
PUBLIC_URL=http://localhost:8000
TIMEZONE=UTC
LOG_LEVEL=INFO

# Database — local fallback is SQLite file; production uses PostgreSQL
# For docker-compose postgres: postgresql+psycopg2://vulnops:vulnops@postgres:5432/vulnops
DATABASE_URL=sqlite:///./vulnops.db
# POSTGRES_DSN=postgresql+psycopg2://vulnops:vulnops@localhost:5432/vulnops

# Object storage (S3/MinIO) — leave unset for SQLite/local ./storage-only dev.
# For MinIO via docker compose or host staging, set all three of endpoint + keys
# (see deploy/env/host-staging-object-storage.env and docs/operations/object-storage.md).
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=vulnops-snapshots
# OBJECT_STORAGE_ACCESS_KEY=minioadmin
# OBJECT_STORAGE_SECRET_KEY=minioadmin
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_LOCAL_MIRROR=false

# Queue
REDIS_URL=redis://localhost:6379/0
# VALKEY_URL=redis://valkey:6379/0

# Auth (OIDC)
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
# Space- or comma-separated asymmetric algorithms accepted by the verifier.
OIDC_ALLOWED_ALGORITHMS=["RS256"]
# Host-run local staging may opt into an IP-loopback HTTP issuer only when
# ENVIRONMENT=staging. Containerized and production APIs must use HTTPS.
OIDC_ALLOW_INSECURE_LOOPBACK=false
OIDC_ORGANIZATION_CLAIM=organizations
OIDC_ROLE_CLAIM=roles
OIDC_SERVICE_SCOPE_CLAIM=scope
OIDC_PRINCIPAL_TYPE_CLAIM=principal_type
# Test-only identity bypass; Task 3 enforces the environment restriction.
AUTH_TEST_BYPASS_ENABLED=false
AUTH_TEST_PRINCIPAL_SUBJECT=test-principal

# Adapters — disabled by default, enable per deployment
VULNERABILITY_LOOKUP_BASE_URL=
DEFECTDOJO_BASE_URL=
WAZUH_BASE_URL=
