# Production SPA OIDC placeholders — bake into the image at build time.
# VITE_OIDC_AUTHORITY must match API OIDC_ISSUER_URL (HTTPS).

VITE_OIDC_AUTHORITY=https://idp.example/realms/vulnops
VITE_OIDC_CLIENT_ID=vulnops-console
VITE_OIDC_REDIRECT_URI=https://hub.example/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://hub.example/login
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_ORGANIZATION_CLAIM=organizations
VITE_OIDC_ROLE_CLAIM=roles
VITE_OIDC_PRINCIPAL_TYPE_CLAIM=principal_type
VITE_OIDC_PERMISSION_CLAIM=permissions
